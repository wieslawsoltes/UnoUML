<Page
    x:Class="UnoUML.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light" Background="#FFFFFF">
    <Page.Resources>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="110"/>
            <Setter Property="Foreground" Value="#77758A"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#242337"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DAD9E4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>
    <Grid x:Name="RootGrid" RowDefinitions="60,*,28" Background="#FFFFFF">
        <Border Grid.Row="0" BorderBrush="#E1E0E9" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="#5D4BD4" CornerRadius="9">
                        <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M6,7 L12,4 18,7 12,10 Z M6,12 L12,15 18,12 M6,17 L12,20 18,17" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="BrandName" Text="UnoUML" Foreground="#232234" FontSize="22" CharacterSpacing="-40" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="FileCrumb" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Border Background="#DDDBE7" Width="1" Height="20"/>
                    <TextBlock x:Name="FileNameText" Text="Checkout flow.puml" FontSize="13" Foreground="#514F61" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="245"/>
                </StackPanel>
                <StackPanel x:Name="AppCommands" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="226"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="236"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="LibraryPanel" Grid.Column="0" Background="#FAFAFC" BorderThickness="0,0,1,0" BorderBrush="#DEDEE8" Padding="14,16,14,10">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="WORKSPACE" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Library" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <StackPanel x:Name="LibraryActions" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Search library…" AutomationProperties.Name="Search library" Style="{StaticResource Field}" TextChanged="OnSearchChanged"/>
                    <StackPanel x:Name="LibraryTabs" Orientation="Horizontal" Grid.Row="2" Spacing="2"/>
                    <TextBlock Grid.Row="3" x:Name="LibraryCaption" Style="{StaticResource Eyebrow}"/>
                    <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LibraryItems" Spacing="3" Padding="0,0,3,4"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="5" Spacing="8">
                        <Border Height="1" Background="#E4E3EB"/>
                        <StackPanel x:Name="LibraryFooter" Spacing="4"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" x:Name="Center" RowDefinitions="Auto,*,Auto" Background="#F4F4F8">
                <Border Background="White" BorderBrush="#E2E1EA" BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                        <StackPanel x:Name="PanelToggleActions" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2"/>
                        <StackPanel x:Name="ViewTabs" Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Background="#F1F0F5" Padding="3" CornerRadius="7" Spacing="1"/>
                        <StackPanel x:Name="HistoryActions" Grid.Column="2" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Grid x:Name="EditorArea" Grid.Row="1" RowDefinitions="*,0" ColumnDefinitions="*,0">
                    <Grid x:Name="DrawingArea" Background="#F5F5F9" RowDefinitions="Auto,*">
                        <StackPanel x:Name="CanvasHeading" Spacing="2" Padding="20,15,20,4">
                            <TextBlock x:Name="CanvasFamily" Style="{StaticResource Eyebrow}"/>
                            <TextBlock x:Name="CanvasTitle" FontWeight="SemiBold" FontSize="21" Foreground="#282737" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Grid x:Name="ViewportHost" Grid.Row="1" MinWidth="0" MinHeight="0"/>
                    </Grid>
                    <Border x:Name="SourcePanel" Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="#DEDFE8" Background="#FCFCFE" Visibility="Collapsed">
                        <Grid RowDefinitions="Auto,*" Padding="12,12,6,8" RowSpacing="8">
                            <TextBlock Text="PLANTUML SOURCE" Style="{StaticResource Eyebrow}"/>
                            <TextBox Grid.Row="1" x:Name="SourceEditor" AcceptsReturn="True" FontFamily="Consolas, Menlo, monospace" FontSize="13" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent" Padding="3,4" VerticalContentAlignment="Top"
                                IsSpellCheckEnabled="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="PlantUML source" TextChanged="OnSourceChanged"/>
                        </Grid>
                    </Border>
                </Grid>
                <Border Grid.Row="2" BorderBrush="#E2E1EA" BorderThickness="0,1,0,0" Background="White" Padding="8,5">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel x:Name="CanvasTools" Orientation="Horizontal" Spacing="1"/>
                        <ComboBox x:Name="PagePicker" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="180" MinWidth="0" MinHeight="30" FontSize="12" SelectionChanged="OnPageChanged" AutomationProperties.Name="Diagram page"/>
                        <StackPanel x:Name="ZoomActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="1"/>
                    </Grid>
                </Border>
            </Grid>
            <Border x:Name="InspectorPanel" Grid.Column="2" Background="#FFFFFF" BorderBrush="#DEDEE8" BorderThickness="1,0,0,0" Padding="14,16,14,8">
                <ScrollViewer x:Name="InspectorScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="11">
                        <StackPanel Spacing="3">
                            <TextBlock Text="PROPERTIES" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Inspector" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <Border Background="#F1EFFB" CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock x:Name="SelectionType" Text="DIAGRAM" Style="{StaticResource Eyebrow}" Foreground="#6151AF"/>
                                <TextBlock x:Name="SelectionTitle" TextWrapping="Wrap" Foreground="#3B3259" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="Properties" Spacing="8"/>
                        <Border Height="1" Background="#ECEBF1" Margin="0,3"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="OUTLINE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="ObjectCount" FontSize="11" Foreground="#77758A"/>
                        </Grid>
                        <StackPanel x:Name="OutlineItems" Spacing="1"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#E2E1EA" Background="#FAFAFC" Padding="12,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#329371"/>
                    <TextBlock x:Name="StatusText" FontSize="11" Foreground="#565466" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Ready"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="DocumentStats" FontSize="11" Foreground="#767385" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
