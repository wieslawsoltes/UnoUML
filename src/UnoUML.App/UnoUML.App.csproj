<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>UnoUML.App</RootNamespace>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoFeatures>NativeRenderer</UnoFeatures>
    <ApplicationTitle>UnoUML</ApplicationTitle>
    <ApplicationId>io.github.wieslawsoltes.unouml</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmShellWebAppBasePath>./</WasmShellWebAppBasePath>
    <Description>A source-preserving visual PlantUML editor.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="wwwroot/uml/vendor/**/*" />
    <ProjectReference Include="../UnoUML.Core/UnoUML.Core.csproj" />
    <ProjectReference Include="../UnoUML.PlantUml/UnoUML.PlantUml.csproj" />
    <UnoIcon Include="Assets/mark.svg" />
    <UnoSplashScreen Include="Assets/launch.svg" Color="#F8F8FC" BaseSize="64,64" />
  </ItemGroup>
  <Target Name="PublishPlantUmlAssets" AfterTargets="Publish">
    <ItemGroup>
      <_UmlAsset Include="wwwroot/uml/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_UmlAsset)" DestinationFiles="@(_UmlAsset->'$(PublishDir)/wwwroot/uml/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
